{
  "name": "dsh-restart-wake",
  "version": "0.1.1",
  "description": "Restart DeepSeek Harness safely and wake sessions automatically afterwards. Agent tools for scheduled self-restart, a startup wake registry, and a mutex-guarded restart protocol. 让 Agent 安全重启 DeepSeek Harness，并在重启后自动回到原会话继续工作。",
  "license": "MIT",
  "author": "zgq0106 (https://github.com/zgq0106)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgq0106/dsh-restart-wake.git"
  },
  "homepage": "https://github.com/zgq0106/dsh-restart-wake#readme",
  "bugs": {
    "url": "https://github.com/zgq0106/dsh-restart-wake/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "scripts/**/*",
    "docs/**/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/**",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "restart",
    "wake",
    "session",
    "agent",
    "automation",
    "windows"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  }
}
